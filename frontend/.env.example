# Base URL of the BuyUpon backend.
VITE_API_BASE_URL=http://localhost:8010
# PayPal client ID fallback. Normally set in the admin (Settings → Payments); this is only used if that is empty.
VITE_PAYPAL_CLIENT_ID=
# Public site origin used for canonical URLs, Open Graph and the sitemap
VITE_SITE_URL=https://buy.cashmymobile.co.uk
