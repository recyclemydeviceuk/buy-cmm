# Set to "true" to run the storefront on the in-browser mock adapter (no backend needed).
VITE_USE_MOCK=true
# Base URL of the BuyUpon backend when VITE_USE_MOCK is not "true".
VITE_API_BASE_URL=http://localhost:8010
# PayPal client ID (sandbox or live). Only used when VITE_USE_MOCK is not "true"; mock mode simulates the PayPal window.
VITE_PAYPAL_CLIENT_ID=
# WhatsApp business number in E.164 without "+" (e.g. 447700900123)
VITE_WHATSAPP_NUMBER=
